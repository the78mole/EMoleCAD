{
  "name": "emolecad",
  "private": true,
  "version": "0.1.0",
  "description": "Elektro-Übersichtspläne (einpolig/allpolig) aus YAML oder grafischem Editor",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/the78mole/EMoleCAD.git"
  },
  "homepage": "https://the78mole.github.io/EMoleCAD/",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:single": "tsc -b && vite build --mode single",
    "test": "vitest run",
    "lint": "oxlint --deny-warnings",
    "preview": "vite preview",
    "render-beispiel": "tsx scripts/render-beispiel.ts"
  },
  "dependencies": {
    "@codemirror/lang-yaml": "^6.1.3",
    "@uiw/react-codemirror": "^4.25.12",
    "@xyflow/react": "^13.0.0",
    "jspdf": "^4.2.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "svg2pdf.js": "^2.9.0",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@types/node": "^26.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "oxlint": "^1.90.0",
    "tsx": "^4.23.15",
    "typescript": "~7.0.2",
    "vite": "^8.3.6",
    "vite-plugin-singlefile": "^2.3.4",
    "vitest": "^5.1.0"
  },
  "engines": {
    "node": ">=22"
  },
  "allowScripts": {
    "esbuild": false,
    "core-js": false
  }
}
